        print(f"  {C_CYAN}[4]{C_RESET} {C_BOLD}{C_WHITE}DEFAULT / STOCK{C_RESET}     -> Restore factory OEM firmware & standard Linux kernel defaults")
        print(f"  {C_CYAN}[5]{C_RESET} {C_BOLD}{C_YELLOW}LIVE MONITOR{C_RESET}        -> Continuous real-time sensor stream")
        print(f"  {C_CYAN}[6]{C_RESET} {C_BOLD}{C_WHITE}ENABLE ON BOOT{C_RESET}      -> Install & enable systemd service for persistence")
