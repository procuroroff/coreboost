        elif choice == "3":
            apply_profile("eco")
            input(f"  {C_DIM}Press Enter to return to menu...{C_RESET}")
        elif choice == "4":
            apply_profile("default")
            input(f"  {C_DIM}Press Enter to return to menu...{C_RESET}")
        elif choice == "5":
            run_live_monitor()
        elif choice == "6":
            enable_systemd_service()
            input(f"  {C_DIM}Press Enter to return to menu...{C_RESET}")
        elif choice == "0" or choice.lower() in ["q", "exit"]:
            print(f"\n  {C_DIM}Session terminated. Kernel state preserved.{C_RESET}\n")
            break
        else:
            print(f"  {C_RED}[!] Invalid selection.{C_RESET}")
            time.sleep(0.7)

if __name__ == "__main__":
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["--apply-saved", "-s"]:
            saved = read_file(CONFIG_FILE, "default")
            apply_profile(saved)
        elif arg in ["turbo", "extreme", "boost"]:
            apply_profile("extreme")
        elif arg in ["balanced", "balance"]:
            apply_profile("balanced")
        elif arg in ["eco", "powersave", "quiet"]:
            apply_profile("eco")
        elif arg in ["default", "stock", "reset"]:
            apply_profile("default")
        elif arg in ["status", "stat"]:
            print_banner()
            print_status_summary()
        elif arg in ["monitor", "live"]:
            run_live_monitor()
        else:
            print(f"Usage: coreboost [extreme | balanced | eco | default | status | monitor]")
    else:
        main_menu()
